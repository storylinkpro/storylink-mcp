{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.storylinkpro/storylink-mcp",
  "title": "Storylink",
  "description": "Ask about your Instagram stories, posts and reels in Storylink: views, reach and top content.",
  "websiteUrl": "https://storylink.pro",
  "repository": {
    "url": "https://github.com/storylinkpro/storylink-mcp",
    "source": "github"
  },
  "version": "1.0.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://storylink.pro/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "storylink-mcp",
      "version": "1.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "STORYLINK_API_KEY",
          "description": "Your Storylink API key (sl_live_…), from the Developers page in Storylink.",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "placeholder": "sl_live_…"
        }
      ]
    }
  ]
}
